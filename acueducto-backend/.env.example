# GitHub Container Registry
GHCR_OWNER=your-github-org-or-user

# Application
SPRING_PROFILES_ACTIVE=prod

# Seguridad JWT (clave propia por entorno, NO usar el default embebido en application.yml)
JWT_SECRET_KEY=<clave-base64-de-al-menos-256-bits>

# Database
DB_URL=jdbc:postgresql://<host>:5432/acueducto_hato
DB_USERNAME=<usuario>
DB_PASSWORD=<password>

# Storage (Contabo Object Storage, S3-compatible, en la VPS)
STORAGE_ENDPOINT=https://usc1.contabostorage.com
STORAGE_TENANT_ID=<tenant-id>
STORAGE_BUCKET=acueducto-hato
CONTABO_ACCESS_KEY=<access-key>
CONTABO_SECRET_KEY=<secret-key>
